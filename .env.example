# =============================================================
# NinjaOne Dashboard Toolkit — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================

# --- NinjaOne API Credentials ---
# Obtain from: NinjaOne Console → Administration → Apps → API → Client App IDs
NINJA_CLIENT_ID=your_client_id_here
NINJA_CLIENT_SECRET=your_client_secret_here

# --- NinjaOne Instance Region ---
# US:  https://app.ninjarmm.com
# EU:  https://eu.ninjarmm.com
# OC:  https://oc.ninjarmm.com
NINJA_BASE_URL=https://app.ninjarmm.com

# --- Dashboard Settings ---
# Port to serve the dashboard on
DASH_PORT=8050
# Set to "true" to enable debug mode (hot-reload, error overlays)
DASH_DEBUG=false
# Set to "true" to run with mock/sample data (no API key required)
DEMO_MODE=false

# --- Cache Settings ---
# How many seconds to cache API responses (default: 300 = 5 minutes)
CACHE_TTL_SECONDS=300

# --- PDF Export ---
# Output directory for exported PDF reports
EXPORT_DIR=./exports
